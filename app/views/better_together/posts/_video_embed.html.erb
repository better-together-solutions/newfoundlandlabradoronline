<%# locals: (post:) -%>
<% if post.video_embed_url.present? %>
  <div class="post-video post-video--<%= post.video_orientation.presence || 'landscape' %> mb-4">
    <%= render partial: 'better_together/content/blocks/iframe_embed',
               locals: {
                 block: post,
                 iframe_url: post.video_embed_url,
                 aspect_ratio: post.video_aspect_ratio,
                 title: post.title.to_s,
                 caption: nil,
                 iframe_allow: 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share',
                 allow_fullscreen: true
               } %>
  </div>
<% end %>
