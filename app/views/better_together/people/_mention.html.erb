<%# locals: (person:, flex_layout: 'flex-row', flex_align_items: 'left', justify_content: 'center', linked: true)%>
<%# Copied from community-engine-rails 929bb51a9492 (app/views/better_together/people/_mention.html.erb). Changes: me-2 on the image wrapper so the image does not touch the name (to be fixed in CE); re-diff when the CE pin moves. -%>
<% profile_path = linked ? mention_profile_path(person) : nil %>

<div class="position-relative mention py-2 me-2 d-flex justify-content-<%= justify_content %> row-gap-1 <%= flex_layout %> <%= "align-items-#{flex_align_items}" %> <%= dom_class(person, :mention) %> <%= 'me' if person == safe_current_person %>" id="<%= dom_id(person, :mention) %>">
  <%# Display avatar and name inline %>
  <div class="h-50 me-2">
    <%= profile_image_tag(person, class: 'mention', size: 50) %>
  </div>
  <div class="h-50 align-self-top">
    <% if profile_path %>
      <a class="text-decoration-none identity-name stretched-link" href="<%= profile_path %>">
        <%= person.name %>
      </a>
    <% else %>
      <span class="identity-name"><%= person.name %></span>
    <% end %>
  </div>
</div>