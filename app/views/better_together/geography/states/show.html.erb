<%# Overrides CE's province page: adds the districts, parties and elections associated with the province. %>
<% code = NewfoundlandLabradorOnline::Province.code_for(@geography_state) %>
<% districts = @geography_state.provincial_electoral_districts.with_translations.order(:identifier) %>
<% parties = @geography_state.political_parties.ever_seated.order(:name) %>
<% elections = @geography_state.elections.latest_first %>
<div class="container" id="province-page">
  <div class="card">
    <div class="card-body">
      <h3 class="card-title mb-3"><%= @geography_state.name %></h3>
      <dl class="row mb-0">
        <dt class="col-md-3">Identifier</dt><dd class="col-md-9"><%= @geography_state.identifier %></dd>
        <dt class="col-md-3">ISO Code</dt><dd class="col-md-9"><%= @geography_state.iso_code %></dd>
        <dt class="col-md-3">Description</dt><dd class="col-md-9"><%= @geography_state.description %></dd>
        <dt class="col-md-3">Slug</dt><dd class="col-md-9"><%= @geography_state.slug %></dd>
        <dt class="col-md-3">Protected</dt><dd class="col-md-9"><%= @geography_state.protected ? 'Yes' : 'No' %></dd>
      </dl>
    </div>
  </div>

  <div class="mt-3">
    <ul class="nav nav-tabs" id="stateTabs" role="tablist">
      <% %w[districts parties elections regions settlements].each_with_index do |tab, index| %>
        <li class="nav-item" role="presentation">
          <a class="nav-link <%= 'active' if index.zero? %>" id="<%= tab %>-tab" data-bs-toggle="tab" href="#<%= tab %>" role="tab" aria-controls="<%= tab %>" aria-selected="<%= index.zero? %>"><%= t("newfoundland_labrador_online.provinces.show.tabs.#{tab}") %></a>
        </li>
      <% end %>
    </ul>
    <div class="tab-content mt-3" id="stateTabsContent">
      <div class="tab-pane fade show active" id="districts" role="tabpanel" aria-labelledby="districts-tab">
        <p><%= link_to t('newfoundland_labrador_online.provinces.show.all_districts'), newfoundland_labrador_online_scoped_districts_path(code, locale: I18n.locale) %></p>
        <ul id="province-districts">
          <% districts.each do |district| %>
            <li><%= link_to district.name, newfoundland_labrador_online_district_path(code, district, locale: I18n.locale) %></li>
          <% end %>
        </ul>
      </div>
      <div class="tab-pane fade" id="parties" role="tabpanel" aria-labelledby="parties-tab">
        <p><%= link_to t('newfoundland_labrador_online.provinces.show.all_parties'), newfoundland_labrador_online_scoped_parties_path('provincial', code, locale: I18n.locale) %></p>
        <ul id="province-parties">
          <% parties.each do |party| %>
            <li><%= link_to party.name, newfoundland_labrador_online_party_path(party.jurisdiction, code, party.identifier, locale: I18n.locale) %></li>
          <% end %>
        </ul>
      </div>
      <div class="tab-pane fade" id="elections" role="tabpanel" aria-labelledby="elections-tab">
        <p><%= link_to t('newfoundland_labrador_online.provinces.show.all_elections'), newfoundland_labrador_online_scoped_elections_path('provincial', code, locale: I18n.locale) %></p>
        <ul id="province-elections">
          <% elections.each do |election| %>
            <li><%= link_to t("newfoundland_labrador_online.elections.index.kinds.#{election.jurisdiction}", year: election.year), newfoundland_labrador_online_election_path(election.jurisdiction, code, election.year, locale: I18n.locale) %>
              <small class="text-muted"><%= l(election.held_on, format: :long) %></small></li>
          <% end %>
        </ul>
      </div>
      <div class="tab-pane fade" id="regions" role="tabpanel" aria-labelledby="regions-tab">
        <ul>
          <% @geography_state.regions.where.not(type: 'NewfoundlandLabradorOnline::ProvincialElectoralDistrict').each do |region| %>
            <li><%= link_to region.name, geography_region_path(region) %></li>
          <% end %>
        </ul>
      </div>
      <div class="tab-pane fade" id="settlements" role="tabpanel" aria-labelledby="settlements-tab">
        <ul>
          <% @geography_state.settlements.each do |settlement| %>
            <li><%= link_to settlement.name, geography_settlement_path(settlement) %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>

  <div class="mt-3">
    <% if policy(@geography_state).edit? %>
      <%= link_to "Edit this state", edit_geography_state_path(@geography_state), class: "btn btn-primary me-2" %>
    <% end %>
    <%= link_to "Back to states", geography_states_path, class: "btn btn-secondary me-2" %>
    <% if policy(@geography_state).destroy? %>
      <%= button_to "Destroy this state", @geography_state, method: :delete, data: { confirm: 'Are you sure?' }, class: "btn btn-danger" %>
    <% end %>
  </div>
</div>
