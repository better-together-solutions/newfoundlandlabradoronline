<%# Copied from community-engine-rails 929bb51a9492 (app/views/better_together/geography/continents/index.html.erb). Changes: the listing map between the heading and the list; re-diff when the CE pin moves. -%>
<% content_for :page_title do %>
  Continents
<% end %>

<div class="container my-3">
  <h1>Continents</h1>

  <%= render 'newfoundland_labrador_online/shared/listing_map', map: listing_map(@geography_continents, kind: 'continents'), title: 'Continents' %>

  <div class="row">
    <div class="col">
      <table class="table">
        <thead>
          <tr>
            <th>Identifier</th>
            <th>Name</th>
            <th>Description</th>
            <th>Slug</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <%= render partial: 'better_together/geography/continents/continent', collection: @geography_continents %>
        </tbody>
      </table>
    </div>
  </div>
</div>
