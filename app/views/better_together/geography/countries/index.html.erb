<%# Copied from community-engine-rails 929bb51a9492 (app/views/better_together/geography/countries/index.html.erb). Changes: the listing map between the heading and the list; re-diff when the CE pin moves. -%>
<% content_for :page_title do %>
  Countries
<% end %>

<div class="container my-3">
  <h1>Countries</h1>

  <%= render 'newfoundland_labrador_online/shared/listing_map', map: listing_map(@countries, kind: 'countries'), title: 'Countries' %>

  <div class="row">
    <div class="col">
      <table class="table">
        <thead>
          <tr>
            <th>Identifier</th>
            <th>Name</th>
            <th>Description</th>
            <th>Slug</th>
            <th>Continents</th>
          </tr>
        </thead>
        <tbody>
          <%= render partial: 'better_together/geography/countries/country', collection: @countries %>
        </tbody>
      </table>
    </div>
  </div>

  <% if policy(::BetterTogether::Geography::Country.new).create? %>
    <%= link_to "New country", new_geography_country_path, class: "btn btn-success mt-3" %>
  <% end %>
</div>
