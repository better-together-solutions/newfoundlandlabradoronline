<%# locals: (settlement:) -%>
<%# Host override of the CE hook partial: the settlement map, between the page header and the tabs. -%>
<% located_map = settlement_map(settlement) %>
<% if located_map.spaces.any? %>
  <section class="settlement-map mb-4" id="settlement-map" aria-label="<%= t('newfoundland_labrador_online.settlement_map.label', name: settlement.name) %>">
    <%= render 'better_together/shared/map', map: located_map, types: located_map.types, boundary: located_map.boundary,
                                                    boundary_attribution: located_map.boundary_credit&.to_h %>
    <% credit = located_map.boundary_credit %>
    <% if credit && located_map.boundary %>
      <p class="settlement-boundary-credit small text-body-secondary mt-1" id="settlement-boundary-credit">
        <%= t('newfoundland_labrador_online.settlement_map.boundary_credit_html',
              credit: BetterTogether::Geography::MapLayer.new(key: 'boundary', **credit.to_h).attribution_html) %>
      </p>
    <% end %>
  </section>
<% end %>
