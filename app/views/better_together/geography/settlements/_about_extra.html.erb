<%# locals: (settlement:) -%>
<%# Host override of the CE hook partial: the current weather card, then the live image card for settlements listed in LiveImage::RECORDS. -%>
<%= render 'better_together/weather/settlement_panel/summary_card', settlement: %>
<% live_slug = NewfoundlandLabradorOnline::LiveImage.slug_for(settlement) %>
<%= render 'newfoundland_labrador_online/live_images/card', slug: live_slug, title: settlement.name if live_slug %>
<%= render 'newfoundland_labrador_online/municipalities/settlement_card', settlement: %>
