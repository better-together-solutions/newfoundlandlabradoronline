<%# NLO override of the gem partial: a municipal council shows as the municipality card, linking to the municipality page. Every other community renders exactly as the gem does. %>
<% council_settlement = community.try(:municipal_settlement) %>
<% if council_settlement %>
  <%= render 'newfoundland_labrador_online/municipalities/host_card', community: community, settlement: council_settlement %>
<% else %>
  <% _kind, mark = community_mark(community) %>
  <% mark_only = mark.present? && !community.cover_image.attached? %>
  <%= render 'better_together/shared/card', entity: community, show_image: !mark_only,
                                            card_classes: "hover-effect community-card#{' community-card--mark-only' if mark_only}" do %>
    <% if mark.present? %>
      <span class="community-card-mark<%= ' community-card-mark--cover' unless mark_only %>" id="<%= dom_id(community, :card_mark) %>">
        <%= image_tag storage_proxy_url_for(mark), alt: '', loading: 'lazy' %>
      </span>
    <% end %>
  <% end %>
<% end %>
