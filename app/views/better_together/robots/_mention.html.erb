<%# NLO override of robots/_mention (copied from better_together dfad67df6). Only change: the avatar is a stacked circle
    icon, as in the share buttons; CE's bare div is flattened to an oval by its h-50 utility. %>
<%# locals: (robot:, flex_layout: 'flex-row', flex_align_items: 'left')%>

<div class="position-relative mention py-2 me-2 d-flex justify-content-center row-gap-1 <%= flex_layout %> <%= "align-items-#{flex_align_items}" %> mention_robot" id="<%= dom_id(robot, :mention) %>">
  <div class="robot-avatar fa-stack fa-2x flex-shrink-0 me-2" role="img" aria-label="<%= t('newfoundland_labrador_online.robots.avatar_label') %>">
    <i class="fas fa-circle fa-stack-2x" aria-hidden="true"></i>
    <i class="fas fa-robot fa-stack-1x text-body-emphasis" aria-hidden="true"></i>
  </div>
  <div class="align-self-center">
    <span class="identity-name d-block"><%= robot.name %></span>
    <small class="text-muted">Robot</small>
  </div>
</div>
