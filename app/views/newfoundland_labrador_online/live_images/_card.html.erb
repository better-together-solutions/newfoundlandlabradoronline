<%# locals: (slug:, title:) -%>
<section class="card mb-3 live-image" id="live-image-<%= slug %>" aria-labelledby="live-image-title-<%= slug %>">
  <div class="card-body p-2">
    <h2 class="h6 mb-2" id="live-image-title-<%= slug %>"><%= t('newfoundland_labrador_online.live_images.title', name: title) %></h2>
    <figure class="mb-0" data-controller="live-image" data-live-image-interval-value="60000">
      <img src="/live/<%= slug %>.jpg" class="img-fluid w-100 rounded" width="1280" height="720"
           alt="<%= t('newfoundland_labrador_online.live_images.alt', name: title) %>" data-live-image-target="image">
      <figcaption class="small text-muted mt-1">
        <%= t('newfoundland_labrador_online.live_images.updated') %> <time data-live-image-target="time"></time>
      </figcaption>
    </figure>
  </div>
</section>
