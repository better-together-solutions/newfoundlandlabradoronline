<div class="container py-4" id="elections-index">
  <h1 class="mb-2"><%= @scope ? t(".titles.#{@scope}") : t('.title') %><% if @province %> <small class="text-muted"><%= @province.name %></small><% end %></h1>
  <p class="text-muted"><%= t('.intro') %></p>
  <% @elections.group_by { |election| [election.jurisdiction, election.state] }.each do |(jurisdiction, state), elections| %>
    <% code = province_code(elections.first) %>
    <section id="elections-<%= jurisdiction %>-<%= code %>">
      <% unless @province %>
        <h2 class="h4 mt-3"><%= link_to "#{t(".titles.#{jurisdiction}")}: #{state.name}", newfoundland_labrador_online_scoped_elections_path(jurisdiction, code, locale: I18n.locale) %></h2>
      <% end %>
      <ul class="list-group" id="elections-list-<%= jurisdiction %>-<%= code %>">
        <% elections.each do |election| %>
          <%= render 'newfoundland_labrador_online/elections/item', election:, seat_counts: @seat_counts %>
        <% end %>
      </ul>
    </section>
  <% end %>
  <p class="mt-3"><%= link_to t('.parties'), province_index_path(:parties) %> ·
     <%= link_to t('.districts'), province_index_path(:districts) %></p>
</div>
