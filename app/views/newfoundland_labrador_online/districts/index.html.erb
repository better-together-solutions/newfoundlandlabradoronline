<div class="container py-4" id="districts-index">
  <h1 class="mb-2"><%= t('.title') %></h1>
  <p class="text-muted"><%= t('.intro', count: @districts.size) %></p>

  <%# Resolved here: a lazy t('.kind') inside the lambda would look up under the map partial's scope. %>
  <% kind = t('.kind') %>
  <%= render 'newfoundland_labrador_online/shared/listing_map',
             map: listing_map(@districts, kind: 'districts', url_for: ->(district) { newfoundland_labrador_online_district_path(district, locale: I18n.locale) },
                                          popup_body: ->(district) { district_popup_body(district, kind:) }),
             title: t('.title'), height: '700px' %>

  <ul class="list-group" id="districts-list">
    <% @districts.each do |district| %>
      <li class="list-group-item" id="<%= dom_id(district, :row) %>">
        <%= link_to district.name, newfoundland_labrador_online_district_path(district, locale: I18n.locale) %>
      </li>
    <% end %>
  </ul>
</div>
