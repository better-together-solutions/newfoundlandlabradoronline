<div class="container py-4" id="district-page">
  <nav aria-label="<%= t('.breadcrumb') %>">
    <%= link_to t('.all_districts'), newfoundland_labrador_online_districts_path(locale: I18n.locale), class: 'btn btn-secondary btn-sm mb-3' %>
  </nav>

  <h1 id="district-name"><%= @district.name %></h1>
  <p class="text-muted" id="district-kind"><%= t('.kind') %></p>

  <% current = @district.current_version %>
  <% located_map = district_map(@district) %>
  <% if current&.boundary %>
    <section class="mb-4" id="district-map-section" aria-label="<%= t('.map_label', name: @district.name) %>">
      <%= render 'better_together/shared/map', map: located_map, types: [], boundary: located_map.boundary, cluster: false %>
    </section>
  <% end %>

  <div class="row g-4">
    <div class="col-lg-6">
      <section class="card h-100" id="district-facts">
        <div class="card-body">
          <h2 class="h5 card-title"><%= t('.facts') %></h2>
          <dl class="row mb-0">
            <dt class="col-sm-5"><%= t('.area') %></dt>
            <dd class="col-sm-7" id="district-area"><%= current ? t('.area_km2', value: number_with_delimiter(current.area_km2.round)) : t('.unknown') %></dd>
            <dt class="col-sm-5"><%= t('.in_force_since') %></dt>
            <dd class="col-sm-7" id="district-since"><%= current ? l(current.valid_from, format: :long) : t('.unknown') %></dd>
            <dt class="col-sm-5"><%= t('.authority') %></dt>
            <dd class="col-sm-7" id="district-authority"><%= current&.authority || t('.unknown') %></dd>
            <dt class="col-sm-5"><%= t('.licence') %></dt>
            <dd class="col-sm-7" id="district-licence"><%= current&.license || t('.unknown') %></dd>
          </dl>
        </div>
      </section>
    </div>

    <div class="col-lg-6">
      <section class="card h-100" id="district-settlements">
        <div class="card-body">
          <h2 class="h5 card-title"><%= t('.settlements') %></h2>
          <% if @settlements.any? %>
            <ul class="mb-0">
              <% @settlements.each do |settlement| %>
                <li><%= link_to settlement.name, geography_settlement_path(settlement, locale: I18n.locale) %></li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-muted mb-0"><%= t('.no_settlements') %></p>
          <% end %>
        </div>
      </section>
    </div>
  </div>

  <section class="card mt-4" id="district-history">
    <div class="card-body">
      <h2 class="h5 card-title"><%= t('.history') %></h2>
      <table class="table table-sm mb-0">
        <thead>
          <tr>
            <th scope="col"><%= t('.version_name') %></th>
            <th scope="col"><%= t('.valid_from') %></th>
            <th scope="col"><%= t('.valid_to') %></th>
          </tr>
        </thead>
        <tbody>
          <% @versions.each do |version| %>
            <tr id="<%= dom_id(version) %>">
              <td><%= version.name %></td>
              <td><%= l(version.valid_from, format: :long) %></td>
              <td><%= version.valid_to ? l(version.valid_to, format: :long) : t('.present') %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="card mt-4" id="district-identifiers">
    <div class="card-body">
      <h2 class="h5 card-title"><%= t('.identifiers') %></h2>
      <dl class="row mb-0">
        <% @identifiers.each do |identifier| %>
          <dt class="col-sm-4"><%= identifier.scheme %></dt>
          <dd class="col-sm-8"><code><%= identifier.value %></code></dd>
        <% end %>
      </dl>
    </div>
  </section>
</div>
