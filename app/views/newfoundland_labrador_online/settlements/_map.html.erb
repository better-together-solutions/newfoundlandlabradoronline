<%# Locals: settlement. Pin, boundary and located items with coordinates (NewfoundlandLabradorOnline::SettlementMap). %>
<% map_data = NewfoundlandLabradorOnline::SettlementMap.new(
     settlement,
     scope_for: ->(model) { policy_scope(model) },
     url_for: ->(record) { polymorphic_path(record) }
   ).as_json %>
<% if map_data[:settlement] %>
  <section class="settlement-map mb-4" aria-label="<%= t('newfoundland_labrador_online.settlement_map.label', name: settlement.name) %>">
    <div class="settlement-map__canvas" data-controller="settlement-map"
         data-settlement-map-data-value="<%= map_data.to_json %>"
         data-settlement-map-count-label-value="<%= t('newfoundland_labrador_online.settlement_map.count_label') %>"
         role="region" aria-label="<%= t('newfoundland_labrador_online.settlement_map.label', name: settlement.name) %>"></div>
    <% if map_data[:items].any? %>
      <fieldset class="settlement-map__legend d-flex flex-wrap gap-3 mt-2" data-settlement-map-legend>
        <legend class="visually-hidden"><%= t('newfoundland_labrador_online.settlement_map.show_types') %></legend>
        <% map_data[:types].each do |type| %>
          <% next unless map_data[:items].any? { |item| item[:type] == type[:key] } %>
          <label class="form-check-label small d-inline-flex align-items-center gap-1">
            <input type="checkbox" class="form-check-input" checked value="<%= type[:key] %>"
                   data-action="settlement-map#toggleType">
            <span class="settlement-map__swatch" style="background: <%= type[:color] %>"></span>
            <%= type[:label] %>
          </label>
        <% end %>
      </fieldset>
    <% end %>
  </section>
<% end %>
