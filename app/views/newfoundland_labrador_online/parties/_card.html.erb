<%# locals: (party:, seats: 0) %>
<div class="col-12 col-md-6 col-xl-4 mb-3" id="<%= dom_id(party) %>">
  <div class="card h-100 shadow-sm border-0" style="border-top: 4px solid <%= party.display_color %> !important">
    <div class="card-body d-flex align-items-center gap-3">
      <% if party.logo.attached? %>
        <%= party_logo_tag(party, class: 'flex-shrink-0', style: 'max-height: 3rem; max-width: 40%; object-fit: contain') %>
      <% end %>
      <div class="min-w-0 flex-grow-1" style="min-width: 0">
        <h3 class="h5 mb-1 text-break"><%= link_to party.name, party_path_for(party), class: 'stretched-link text-decoration-none' %></h3>
        <p class="small text-muted mb-0" id="<%= dom_id(party, :seats) %>"><%= t('newfoundland_labrador_online.parties.index.seats', count: seats) %></p>
      </div>
    </div>
  </div>
</div>
