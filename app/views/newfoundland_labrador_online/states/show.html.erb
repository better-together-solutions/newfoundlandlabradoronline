<% province = @state.province? %>
<% code = NewfoundlandLabradorOnline::Province.code_for(@state) if province %>
<% tabs = province ? %w[districts parties elections regions settlements] : %w[regions settlements] %>
<% districts = @districts %>
<% parties = @parties %>
<% elections = @elections %>
<div class="container" id="state-page">
  <div class="card">
    <div class="card-body">
      <h3 class="card-title mb-3"><%= @state.name %></h3>
      <dl class="row mb-0">
        <dt class="col-md-3">Identifier</dt><dd class="col-md-9"><%= @state.identifier %></dd>
        <dt class="col-md-3">ISO Code</dt><dd class="col-md-9"><%= @state.iso_code %></dd>
        <dt class="col-md-3">Description</dt><dd class="col-md-9"><%= @state.description %></dd>
        <dt class="col-md-3">Slug</dt><dd class="col-md-9"><%= @state.slug %></dd>
        <dt class="col-md-3">Protected</dt><dd class="col-md-9"><%= @state.protected ? 'Yes' : 'No' %></dd>
      </dl>
    </div>
  </div>

  <div class="mt-3">
    <ul class="nav nav-tabs" id="stateTabs" role="tablist">
      <% tabs.each_with_index do |tab, index| %>
        <li class="nav-item" role="presentation">
          <a class="nav-link <%= 'active' if index.zero? %>" id="<%= tab %>-tab" data-bs-toggle="tab" href="#<%= tab %>" role="tab" aria-controls="<%= tab %>" aria-selected="<%= index.zero? %>"><%= t("newfoundland_labrador_online.states.show.tabs.#{tab}") %></a>
        </li>
      <% end %>
    </ul>
    <div class="tab-content mt-3" id="stateTabsContent">
      <% if province %>
      <div class="tab-pane fade show active" id="districts" role="tabpanel" aria-labelledby="districts-tab">
        <p><%= link_to t('newfoundland_labrador_online.states.show.all_districts'), newfoundland_labrador_online_scoped_districts_path(code, locale: I18n.locale) %></p>
        <% if NewfoundlandLabradorOnline::Civic::Provisioner.new.legislature_for(@state) %>
          <p id="province-legislature-link"><%= link_to t('newfoundland_labrador_online.states.show.all_legislature'), newfoundland_labrador_online_legislature_path(code, locale: I18n.locale) %></p>
        <% end %>
        <ul id="province-districts">
          <% districts.each do |district| %>
            <li><%= link_to district.name, newfoundland_labrador_online_district_path(code, district, locale: I18n.locale) %></li>
          <% end %>
        </ul>
      </div>
      <div class="tab-pane fade" id="parties" role="tabpanel" aria-labelledby="parties-tab">
        <p><%= link_to t('newfoundland_labrador_online.states.show.all_parties'), newfoundland_labrador_online_scoped_parties_path('provincial', code, locale: I18n.locale) %></p>
        <ul id="province-parties">
          <% parties.each do |party| %>
            <li><%= link_to party.name, newfoundland_labrador_online_party_path(party.jurisdiction, code, party.identifier, locale: I18n.locale) %></li>
          <% end %>
        </ul>
      </div>
      <div class="tab-pane fade" id="elections" role="tabpanel" aria-labelledby="elections-tab">
        <p><%= link_to t('newfoundland_labrador_online.states.show.all_elections'), newfoundland_labrador_online_scoped_elections_path('provincial', code, locale: I18n.locale) %></p>
        <ul id="province-elections">
          <% elections.each do |election| %>
            <li><%= link_to t("newfoundland_labrador_online.elections.index.kinds.#{election.jurisdiction}", year: election.year), newfoundland_labrador_online_election_path(election.jurisdiction, code, election.year, locale: I18n.locale) %>
              <small class="text-muted"><%= l(election.held_on, format: :long) %></small></li>
          <% end %>
        </ul>
      </div>
      <% end %>
      <div class="tab-pane fade <%= 'show active' unless province %>" id="regions" role="tabpanel" aria-labelledby="regions-tab">
        <ul>
          <% @state.regions.where.not(type: 'NewfoundlandLabradorOnline::ProvincialElectoralDistrict').each do |region| %>
            <li><%= link_to region.name, geography_region_path(region, locale: I18n.locale) %></li>
          <% end %>
        </ul>
      </div>
      <div class="tab-pane fade" id="settlements" role="tabpanel" aria-labelledby="settlements-tab">
        <ul>
          <% @state.settlements.each do |settlement| %>
            <li><%= link_to settlement.name, geography_settlement_path(settlement, locale: I18n.locale) %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>

  <% if policy(@state).update? %>
    <%= link_to t('.manage'), geography_state_path(@state, locale: I18n.locale), class: 'btn btn-primary mt-3' %>
  <% end %>
</div>
