<%# locals: (community:, settlement:) -%>
<%# A municipal council as an event host: the municipality card, linking to the municipality page (not the community page). -%>
<% municipality = NewfoundlandLabradorOnline::Civic::Municipality.for(settlement) %>
<% code = NewfoundlandLabradorOnline::Province.code_for(settlement.state) %>
<% path = newfoundland_labrador_online_municipality_path(code, settlement, locale: I18n.locale) %>
<div id="<%= dom_id(community) %>" class="community col col-md-6 col-xl-4 entity-column mb-3">
  <div class="card entity h-100 shadow-sm border-0 hover-effect municipality-host-card" id="<%= dom_id(community, :municipality_card) %>">
    <div class="card-body d-flex flex-column">
      <h5 class="card-title mb-1">
        <%= link_to community.name, path, class: 'text-primary text-decoration-none stretched-link' %>
      </h5>
      <% if municipality&.mayor %>
        <p class="card-text small text-muted mb-1"><%= t('newfoundland_labrador_online.municipalities.card.mayor', name: municipality.mayor.person.name) %></p>
      <% end %>
      <p class="card-text small text-muted mb-0"><%= t('newfoundland_labrador_online.municipalities.card.link') %></p>
    </div>
  </div>
</div>
